# Raw data are intentionally not versioned.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Generated analysis outputs.
data/intermediate/*
!data/intermediate/.gitkeep
data/databases/*
!data/databases/README.md
!data/databases/CURATED_DATABASES.md
!data/databases/PGMDB.tab
!data/databases/gut_brain_axis_marker_database.tsv
!data/databases/gut_brain_axis_marker_database.modules.tsv
!data/databases/probiotic_cazy.txt
data/results/*
!data/results/.gitkeep
data/reports/
data/state/
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# Local containers can be large and should be rebuilt or documented.
app_containers/*.sif
app_containers/*.sandbox/

# Snakemake runtime state.
.snakemake/
.tmp/

