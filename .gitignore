# Raw data are intentionally not versioned.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Generated analysis outputs.
data/intermediate/*
!data/intermediate/.gitkeep
data/databases/*
!data/databases/README.md
data/results/*
!data/results/.gitkeep
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# Local containers can be large and should be rebuilt or documented.
app_containers/*.sif
app_containers/*.sandbox/

# Snakemake runtime state.
.snakemake/
.tmp/

# Local package managers, caches, and environments.
.cache/
downloads/
mamba_envs/
mamba_pkgs/
micromamba-root/
tools/

# Python/editor noise.
__pycache__/
*.py[cod]
.DS_Store
