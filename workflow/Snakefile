        export HOME="$PWD/.home"
        mkdir -p "$HOME/.cache/fastmlst"
        rm -rf "$HOME/.cache/fastmlst/pubmlst"
        ln -s "$PWD/data/databases/fastmlst/pubmlst" "$HOME/.cache/fastmlst/pubmlst"
        mamba_envs/fastmlst/bin/fastmlst --db_path data/databases/fastmlst/pubmlst -t {threads} -s '\t' {input.assembly} > {output.mlst} 2>> {log}
        grep -q '[^[:space:]]' {output.mlst} || printf 'Genome\tScheme\tST\n' > {output.mlst}
        """


rule fastani_references:
    input:
        sourmash_gather="data/results/{sample}/sourmash/gather.with-lineages.csv",
        script="workflow/scripts/fastani_pipeline.py"
    output:
        ready=temp("data/results/{sample}/fastani/refs/references.ready"),
        references="data/results/{sample}/fastani/refs/references.tsv"
    log:
        "logs/fastani/fastani_references_{sample}.log"
    resources:
        mem_mb=4000
    conda:
        env("fastani")
    params:
        reference_genomes=lambda wc: int(config["params"].get("fastani_reference_genomes", 15))
    shell:
        r"""
        root="${{PROBEAT_ROOT:-$PWD}}"
        mkdir -p data/results/{wildcards.sample}/fastani
        export PATH="$root/mamba_envs/fastani/bin:$PATH"
        py="$root/mamba_envs/fastani/bin/python"
        if ! test -x "$py"; then
            py="$(command -v python || true)"
        fi
        test -x "$py" || (echo "Missing Python for FastANI reference downloader" >&2; exit 2)
        "$py" {input.script} download \
            {input.sourmash_gather} data/results/{wildcards.sample}/fastani/refs \
            {output.ready} {params.reference_genomes} > {log} 2>&1
        test -s {output.ready}
        test -s {output.references}
        """


rule fastani:
    input:
        assembly=assembly,
        references_ready="data/results/{sample}/fastani/refs/references.ready",
        references="data/results/{sample}/fastani/refs/references.tsv",
        script="workflow/scripts/fastani_pipeline.py"
    output:
        heatmap="data/results/{sample}/fastani/{sample}_ani_heatmap.png",
        ani_tsv="data/results/{sample}/fastani/{sample}_fastani.tsv"
    log:
        "logs/fastani/fastani_{sample}.log"
    threads: 4
    resources:
        mem_mb=16000
    params:
        reference_genomes=lambda wc: int(config["params"].get("fastani_reference_genomes", 15))
    conda:
        env("fastani")
    shell:
        r"""
        root="${{PROBEAT_ROOT:-$PWD}}"
        mkdir -p data/results/{wildcards.sample}/fastani
        export PATH="$root/mamba_envs/fastani/bin:$PATH"
        export LD_LIBRARY_PATH="$root/mamba_envs/fastani/lib:${{LD_LIBRARY_PATH:-}}"
        fastani_bin="$root/mamba_envs/fastani/bin/fastani"
        if ! test -x "$fastani_bin"; then
            fastani_bin="$(command -v fastani || true)"
        fi
        if ! test -x "$fastani_bin"; then
            fastani_bin="$(command -v fastANI || true)"
        fi
        test -x "$fastani_bin" || (echo "Missing FastANI executable" >&2; exit 2)
        export FASTANI_BIN="$fastani_bin"
        export MPLCONFIGDIR="$root/.cache/matplotlib"
        py="$root/mamba_envs/fastani/bin/python"
        if ! test -x "$py"; then
            py="$(command -v python || true)"
        fi
        test -x "$py" || (echo "Missing Python for FastANI runner" >&2; exit 2)
        "$py" {input.script} run \
            {input.assembly} {wildcards.sample} \
            data/results/{wildcards.sample}/fastani/refs \
            {output.ani_tsv} {output.heatmap} {params.reference_genomes} >> {log} 2>&1
        test -s {output.heatmap}
        test -s {output.ani_tsv}
        """


rule multiqc:
    input:
        ANALYSIS_TARGETS
    output:
        html="data/results/multiqc/multiqc_report.html"
    log:
        "logs/multiqc/multiqc.log"
    threads: 2
    resources:
        mem_mb=8000
    conda:
        env("multiqc")
    shell:
        "multiqc data/results logs --outdir data/results/multiqc --filename multiqc_report.html --force > {log} 2>&1"


rule final_report:
    input:
        analysis=lambda wc: sample_analysis_targets(wc.sample),
        script="workflow/scripts/render_report.py",
        workflow_graph="data/workflow_grouped.png"
    output:
        html="data/results/{sample}/report/{sample}_report.html",
        pdf="data/results/{sample}/report/{sample}_report.pdf"
    log:
        "logs/report/final_report_{sample}.log"
    shell:
        r"""
        ts=$(date +%Y%m%d_%H%M%S)
        {PYTHON} \
            workflow/scripts/tree_results.py {wildcards.sample} data/results/{wildcards.sample}/tree.txt
        {PYTHON} \
            workflow/scripts/render_report.py workflow/config/config.yaml {config[samples_file]} \
            {output.html} {output.pdf} {wildcards.sample} > {log} 2>&1
        cp {output.html} data/results/{wildcards.sample}/report/{wildcards.sample}_report_$ts.html
        cp {output.pdf} data/results/{wildcards.sample}/report/{wildcards.sample}_report_$ts.pdf
        chmod 644 {output.html} {output.pdf} \
            data/results/{wildcards.sample}/report/{wildcards.sample}_report_$ts.html \
            data/results/{wildcards.sample}/report/{wildcards.sample}_report_$ts.pdf
        """
