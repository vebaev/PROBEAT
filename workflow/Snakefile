configfile: "workflow/config/config.yaml"

import csv
from pathlib import Path


def load_samples(samples_file):
    path = Path(samples_file)
    if not path.exists():
        return {}
    with path.open(newline="") as handle:
        rows = list(csv.DictReader(handle, delimiter="\t"))
    samples = {}
    for row in rows:
        sample = row["sample"].strip()
        if not sample:
            continue
        layout = row["layout"].strip().upper()
        if layout not in {"PE", "SE"}:
            raise ValueError(f"Sample {sample} has unsupported layout: {layout}")
        if not row["r1"].strip():
            raise ValueError(f"Sample {sample} is missing r1")
        if layout == "PE" and not row["r2"].strip():
            raise ValueError(f"Sample {sample} is PE but missing r2")
        samples[sample] = {"layout": layout, "r1": row["r1"].strip(), "r2": row["r2"].strip()}
    return samples


SAMPLES = load_samples(config["samples_file"])
SAMPLE_NAMES = sorted(SAMPLES)


def container(name):
    return config["containers"][name]


def db(name):
    return config["databases"][name]


def assembly_for_sample(sample):
    return f"data/results/assemblies/{sample}/assembly.fasta"


def assembly(wildcards):
    return assembly_for_sample(wildcards.sample)


def trimmed_done(sample):
    return f"data/intermediate/trimmed/{sample}.done"


def fastqc_targets():
    targets = []
    for sample, meta in SAMPLES.items():
        targets.append(f"data/results/qc/fastqc/{sample}_R1_fastqc.html")
        if meta["layout"] == "PE":
            targets.append(f"data/results/qc/fastqc/{sample}_R2_fastqc.html")
    return targets


def workflow_targets():
    if not SAMPLE_NAMES:
        return ["data/results/workflow_initialized.txt", "reports/workflow_initialized.txt"]
    targets = []
    targets += fastqc_targets()
    targets += [assembly_for_sample(s) for s in SAMPLE_NAMES]
    targets += [f"data/results/quast/{s}/report.tsv" for s in SAMPLE_NAMES]
    targets += [f"data/results/checkm2/{s}/quality_report.tsv" for s in SAMPLE_NAMES]
    targets += [f"data/results/gtdbtk/{s}/gtdbtk.bac120.summary.tsv" for s in SAMPLE_NAMES]
    targets += [f"data/results/bakta/{s}/{s}.gff3" for s in SAMPLE_NAMES]
    targets += [f"data/results/amrfinder/{s}.tsv" for s in SAMPLE_NAMES]
    targets += [f"data/results/bagel4/{s}/bagel4.done" for s in SAMPLE_NAMES]
    targets += [f"data/results/antismash/{s}/index.html" for s in SAMPLE_NAMES]
    targets += [f"data/results/mobsuite/{s}/mobtyper_results.txt" for s in SAMPLE_NAMES]
    return targets


ANALYSIS_TARGETS = workflow_targets()
FINAL_TARGETS = ANALYSIS_TARGETS + ["data/results/multiqc/multiqc_report.html", "reports/bacterial_genome_report.html", "reports/bacterial_genome_report.pdf"] if SAMPLE_NAMES else ANALYSIS_TARGETS


rule all:
    input:
        FINAL_TARGETS


rule initialize_workspace:
    output:
        results="data/results/workflow_initialized.txt",
        report="reports/workflow_initialized.txt"
    log:
        "logs/initialize_workspace.log"
    shell:
        r"""
        set -euo pipefail
        {{
            echo "Workspace initialized by Snakemake"
            echo "Raw data directory: {config[paths][raw]}"
            echo "Intermediate directory: {config[paths][intermediate]}"
            echo "Results directory: {config[paths][results]}"
            echo "Reports directory: {config[paths][reports]}"
            echo "Containers directory: {config[paths][containers]}"
        }} > {output.results}

        {{
            echo "Add samples to workflow/config/samples.tsv."
            echo "Bioinformatics applications run through Apptainer containers."
        }} > {output.report}
        """


rule fastp_pe:
    input:
        r1=lambda wc: SAMPLES[wc.sample]["r1"],
        r2=lambda wc: SAMPLES[wc.sample]["r2"]
    output:
        r1="data/intermediate/trimmed/{sample}_R1.fastq.gz",
        r2="data/intermediate/trimmed/{sample}_R2.fastq.gz",
        html="data/results/qc/fastp/{sample}.html",
        json="data/results/qc/fastp/{sample}.json",
        done="data/intermediate/trimmed/{sample}.done"
    log:
        "logs/trimmed/fastp_{sample}.log"
    threads: 8
    resources:
        mem_mb=12000
    container:
        container("fastp")
    params:
        layout=lambda wc: SAMPLES[wc.sample]["layout"]
    shell:
        r"""
        test "{params.layout}" = "PE"
        fastp --thread {threads} --in1 {input.r1} --in2 {input.r2} --out1 {output.r1} --out2 {output.r2} --html {output.html} --json {output.json} > {log} 2>&1
        touch {output.done}
        """


