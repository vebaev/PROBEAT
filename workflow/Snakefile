    params:
        executable=lambda wc: tool("sourmash")
    shell:
        r"""
        mkdir -p data/results/{wildcards.sample}/sourmash
        {params.executable} sketch dna -p k=31,scaled=1000 \
            --name {wildcards.sample} \
            -o {output.signature} {input.assembly} > {log} 2>&1
        """


rule sourmash_gtdb:
    input:
        signature="data/results/{sample}/sourmash/{sample}.k31.sig.zip"
    output:
        gather="data/results/{sample}/sourmash/gather.csv",
        annotated="data/results/{sample}/sourmash/gather.with-lineages.csv"
    log:
        "logs/sourmash/gtdb_{sample}.log"
    threads: 4
    resources:
        mem_mb=8000
    params:
        executable=lambda wc: tool("sourmash"),
        database=lambda wc: db("sourmash_gtdb"),
        lineages=lambda wc: db("sourmash_gtdb_lineages")
    shell:
        r"""
        test -s "{params.database}" || (echo "Missing sourmash GTDB database: {params.database}" >&2; exit 2)
        test -s "{params.lineages}" || (echo "Missing sourmash GTDB lineages: {params.lineages}" >&2; exit 2)
        if ! {params.executable} gather {input.signature} {params.database} \
            --threshold-bp 10000 -o {output.gather} > {log} 2>&1; then
            if grep -qi "No matches found" {log}; then
                printf 'intersect_bp,f_orig_query,f_match,f_unique_to_query,name,lineage\n' > {output.gather}
                printf 'intersect_bp,f_orig_query,f_match,f_unique_to_query,name,lineage\n' > {output.annotated}
                echo "sourmash gather found no GTDB matches above threshold; wrote empty annotated output." >> {log}
                exit 0
            fi
            exit 1
        fi
        if [ ! -s {output.gather} ]; then
            printf 'intersect_bp,f_orig_query,f_match,f_unique_to_query,name,lineage\n' > {output.gather}
            printf 'intersect_bp,f_orig_query,f_match,f_unique_to_query,name,lineage\n' > {output.annotated}
            echo "sourmash gather produced no rows; wrote empty annotated output." >> {log}
            exit 0
        fi
        {params.executable} tax annotate \
            --gather-csv {output.gather} \
            --taxonomy {params.lineages} \
            --output-dir data/results/{wildcards.sample}/sourmash >> {log} 2>&1
        annotated="$(find data/results/{wildcards.sample}/sourmash -maxdepth 1 -type f -name '*with-lineages.csv' | head -n 1)"
        if [ -z "$annotated" ] || [ ! -s "$annotated" ]; then
            printf 'intersect_bp,f_orig_query,f_match,f_unique_to_query,name,lineage\n' > {output.annotated}
            echo "sourmash tax annotate produced no rows; wrote empty annotated output." >> {log}
            exit 0
        fi
        if [ "$annotated" != "{output.annotated}" ]; then
            cp "$annotated" {output.annotated}
        fi
        """


rule busco:
    input:
        assembly=assembly
    output:
        summary="data/results/{sample}/busco/busco_summary.txt"
    log:
        "logs/busco/busco_{sample}.log"
    threads: 8
    resources:
        mem_mb=16000
    params:
        executable=lambda wc: tool("busco"),
        database=lambda wc: db("busco"),
        lineage=lambda wc: config["params"].get("busco_lineage", "bacteria_odb10")
    shell:
        r"""
        test -x "{params.executable}" || (echo "Missing BUSCO executable: {params.executable}" >&2; exit 2)
        lineage="{params.lineage}"
        if [ -d "{params.database}/lineages/{params.lineage}" ]; then
            lineage="{params.database}/lineages/{params.lineage}"
        elif [ -d "{params.database}/{params.lineage}" ]; then
            lineage="{params.database}/{params.lineage}"
        else
            echo "Missing BUSCO lineage dataset: {params.database}/lineages/{params.lineage}" >&2
            exit 2
        fi
        mkdir -p data/results/{wildcards.sample}/busco logs/busco
        env PATH="$(dirname {params.executable}):$PATH" {params.executable} -i {input.assembly} -m genome -l "$lineage" --offline --download_path {params.database} --out_path data/results/{wildcards.sample}/busco -o {wildcards.sample} --cpu {threads} --force > {log} 2>&1
        summary="$(find data/results/{wildcards.sample}/busco -type f -name 'short_summary*.txt' | head -n 1)"
        test -s "$summary" || (echo "Missing BUSCO short summary" >&2; exit 2)
        cp "$summary" {output.summary}
        """


