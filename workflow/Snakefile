rule fastqc_r1:
    input:
        lambda wc: SAMPLES[wc.sample]["r1"]
    output:
        html="data/results/qc/fastqc/{sample}_R1_fastqc.html",
        zip="data/results/qc/fastqc/{sample}_R1_fastqc.zip"
    log:
        "logs/qc/fastqc_{sample}_R1.log"
    threads: 2
    resources:
        mem_mb=4000
    container:
        container("fastqc")
    shell:
        r"""
        mkdir -p data/intermediate/fastqc_inputs data/results/qc/fastqc
        ln -sf "$(realpath {input})" data/intermediate/fastqc_inputs/{wildcards.sample}_R1.fastq.gz
        fastqc --threads {threads} --outdir data/results/qc/fastqc data/intermediate/fastqc_inputs/{wildcards.sample}_R1.fastq.gz > {log} 2>&1
        """


