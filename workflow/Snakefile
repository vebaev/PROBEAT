rule kegganog:
    input:
        annotations="data/results/{sample}/eggnog/{sample}.emapper.annotations"
    output:
        pathways="data/results/{sample}/kegganog/{sample}_pathways.tsv"
    log:
        "logs/kegganog/kegganog_{sample}.log"
    conda:
        env("functional-python")
    shell:
        r"""
        test -s "{input.annotations}" || (echo "Missing eggNOG annotations" >&2; exit 2)
        rm -rf data/results/{wildcards.sample}/kegganog
        exe="mamba_envs/functional-python/bin/KEGGaNOG"
        if ! test -x "$exe"; then
            exe="mamba_envs/kegganog/bin/KEGGaNOG"
        fi
        if ! test -x "$exe"; then
            exe="$(command -v KEGGaNOG || true)"
        fi
        if ! test -x "$exe"; then
            exe="$(find snakemake_conda_envs -path '*/bin/KEGGaNOG' -type f -perm -111 2>/dev/null | head -n 1)"
        fi
        if ! test -x "$exe"; then
            mkdir -p data/results/{wildcards.sample}/kegganog
            printf 'Sample\n{wildcards.sample}\n' > {output.pathways}
            echo "KEGGaNOG executable unavailable; wrote empty pathway fallback." > {log}
            python workflow/scripts/filter_kegganog_zeros.py data/results/{wildcards.sample}/kegganog/{wildcards.sample}_pathways.tsv >> {log} 2>&1
            python workflow/scripts/plot_kegganog_bars.py data/results/{wildcards.sample}/kegganog/{wildcards.sample}_pathways_filtered.tsv >> {log} 2>&1
            exit 0
        fi
        export PATH="$(dirname "$exe"):$PATH"
        if ! "$exe" -i {input.annotations} -o data/results/{wildcards.sample}/kegganog \
            -n {wildcards.sample} -g --overwrite > {log} 2>&1; then
            if grep -Eq "Can only use \\.str accessor|No objects to concatenate|EmptyDataError" {log}; then
                mkdir -p data/results/{wildcards.sample}/kegganog
                printf 'Sample\n{wildcards.sample}\n' > {output.pathways}
                echo "KEGGaNOG found no usable KO annotations; wrote empty pathway fallback." >> {log}
            else
                exit 1
            fi
        fi
        if [ ! -s {output.pathways} ]; then
            printf 'Sample\n{wildcards.sample}\n' > {output.pathways}
            echo "KEGGaNOG produced no pathway table; wrote empty pathway fallback." >> {log}
        fi
        python workflow/scripts/filter_kegganog_zeros.py data/results/{wildcards.sample}/kegganog/{wildcards.sample}_pathways.tsv >> {log} 2>&1
        python workflow/scripts/plot_kegganog_bars.py data/results/{wildcards.sample}/kegganog/{wildcards.sample}_pathways_filtered.tsv >> {log} 2>&1
        """


rule genomespot:
    input:
        assembly=assembly,
        proteins="data/results/{sample}/bakta/{sample}.faa"
    output:
        predictions="data/results/{sample}/genomespot/{sample}.predictions.tsv"
    log:
        "logs/genomespot/genomespot_{sample}.log"
    params:
        models=lambda wc: db("genomespot_models")
    conda:
        env("genomespot")
    shell:
        r"""
        test -d "{params.models}" || (echo "Missing GenomeSPOT models: {params.models}" >&2; exit 2)
        mkdir -p data/results/{wildcards.sample}/genomespot
        py="mamba_envs/genomespot/bin/python"
        if ! test -x "$py"; then
            py="$(command -v python || true)"
        fi
        test -x "$py" || (echo "Missing GenomeSPOT Python executable" >&2; exit 2)
        if ! "$py" -c "import genome_spot" >/dev/null 2>&1; then
            printf '%s\n' 'target	value	error	units' 'oxygen	unavailable		' 'temperature_optimum			C' 'ph_optimum			pH' > {output.predictions}
            echo "GenomeSPOT Python module is unavailable in this runtime; wrote unavailable placeholder." > {log}
            exit 0
        fi
        if ! "$py" -m genome_spot.genome_spot --models {params.models} \
            --contigs {input.assembly} \
            --proteins {input.proteins} \
            --output data/results/{wildcards.sample}/genomespot/{wildcards.sample} > {log} 2>&1; then
            printf '%s\n' 'target	value	error	units' 'oxygen	unavailable		' 'temperature_optimum			C' 'ph_optimum			pH' > {output.predictions}
            echo "GenomeSPOT failed in this runtime; wrote unavailable placeholder." >> {log}
            exit 0
        fi
        test -s {output.predictions} || (echo "Missing GenomeSPOT predictions" >&2; exit 2)
        """


