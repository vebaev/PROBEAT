rule kofamscan:
    input:
        proteins="data/results/{sample}/bakta/{sample}.faa"
    output:
        tsv="data/results/{sample}/kofamscan/{sample}.tsv"
    log:
        "logs/kofamscan/kofamscan_{sample}.log"
    threads: 8
    resources:
        mem_mb=24000
    conda:
        env("kofamscan")
    params:
        executable=lambda wc: tool("kofamscan"),
        database=lambda wc: db("kofamscan")
    shell:
        r"""
        test -s "{params.database}/profiles/prokaryote.hal" || test -s "{params.database}/profiles/prokaryote.hmm" || test -d "{params.database}/profiles" || (echo "Missing KOfam profiles in {params.database}/profiles" >&2; exit 2)
        test -s "{params.database}/ko_list" || (echo "Missing KOfam ko_list in {params.database}/ko_list" >&2; exit 2)
        mkdir -p data/results/{wildcards.sample}/kofamscan
        exe="{params.executable}"
        if ! test -x "$exe"; then
            exe="$(command -v exec_annotation || true)"
        fi
        if ! test -x "$exe"; then
            for candidate in mamba_envs/kofamscan*/bin/exec_annotation snakemake_conda_envs/*/bin/exec_annotation .snakemake/conda/*/bin/exec_annotation; do
                if test -x "$candidate"; then
                    exe="$candidate"
                    break
                fi
            done
        fi
        test -x "$exe" || (echo "Missing KOfamScan exec_annotation executable" >&2; exit 2)
        env -u RUBYLIB PATH="$(dirname "$exe"):$PATH" \
            "$exe" --cpu {threads} --profile {params.database}/profiles --ko-list {params.database}/ko_list --format mapper --no-report-unannotated {input.proteins} > {output.tsv} 2> {log}
        """


rule keggdecoder:
    input:
        kofam="data/results/{sample}/kofamscan/{sample}.tsv",
        fallback_script="workflow/scripts/keggdecoder_kofam_fallback.py"
    output:
        completeness="data/results/{sample}/keggdecoder/pathway_completeness.tsv",
        heatmap="data/results/{sample}/keggdecoder/pathway_completeness.svg"
    log:
        "logs/keggdecoder/keggdecoder_{sample}.log"
    threads: 2
    resources:
        mem_mb=8000
    conda:
        env("functional-python")
    params:
        executable=lambda wc: tool("keggdecoder")
    shell:
        r"""
        exe="{params.executable}"
        if ! test -x "$exe"; then
            exe="$(command -v KEGG-decoder || true)"
        fi
        rm -rf data/results/{wildcards.sample}/keggdecoder
        mkdir -p data/results/{wildcards.sample}/keggdecoder
        if ! test -x "$exe"; then
            python {input.fallback_script} {input.kofam} {wildcards.sample} {output.completeness} {output.heatmap} > {log} 2>&1
            echo "Missing KEGGDecoder executable; wrote KOfamScan-based fallback completeness." >> {log}
            exit 0
        fi
        if ! env PATH="$(dirname "$exe"):$PATH" MPLCONFIGDIR="$PWD/.cache/matplotlib" \
            "$exe" --input {input.kofam} \
            --output data/results/{wildcards.sample}/keggdecoder/pathway_completeness.tsv \
            --vizoption static > {log} 2>&1; then
            if env PATH="$(dirname "$exe"):$PATH" MPLCONFIGDIR="$PWD/.cache/matplotlib" \
                "$exe" --input {input.kofam} \
                --output data/results/{wildcards.sample}/keggdecoder/pathway_completeness.tsv >> {log} 2>&1; then
                python {input.fallback_script} {input.kofam} {wildcards.sample} {output.completeness} {output.heatmap} >> {log} 2>&1
            else
                python {input.fallback_script} {input.kofam} {wildcards.sample} {output.completeness} {output.heatmap} >> {log} 2>&1
            fi
            exit 0
        fi
        heatmap="$(find data/results/{wildcards.sample}/keggdecoder -maxdepth 1 -type f \( -name '*.svg' -o -name '*.pdf' -o -name '*.png' \) | head -n 1)"
        test -s {output.completeness} || (echo "Missing KEGGDecoder pathway completeness table" >&2; exit 2)
        test -s "$heatmap" || (echo "Missing KEGGDecoder heatmap" >&2; exit 2)
        if [ "$heatmap" != "{output.heatmap}" ]; then
            cp "$heatmap" {output.heatmap}
        fi
        """


