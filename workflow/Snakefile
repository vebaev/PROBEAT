rule bakta:
    input:
        assembly=assembly
    output:
        gff="data/results/{sample}/bakta/{sample}.gff3",
        faa="data/results/{sample}/bakta/{sample}.faa",
        tsv="data/results/{sample}/bakta/{sample}.tsv",
        txt="data/results/{sample}/bakta/{sample}.txt",
        png="data/results/{sample}/bakta/{sample}.png",
        fna="data/results/{sample}/bakta/{sample}.fna"
    log:
        "logs/bakta/bakta_{sample}.log"
    threads: 16
    resources:
        mem_mb=64000
    params:
        executable=lambda wc: tool("bakta"),
        database=lambda wc: db("bakta"),
        trna_wrapper=lambda wc: str(Path(workflow.basedir).joinpath("scripts", "tRNAscan-SE"))
    shell:
        r"""
        test -x "{params.executable}" || (echo "Missing Bakta executable: {params.executable}" >&2; exit 2)
        test -d "{params.database}" || (echo "Missing Bakta database: {params.database}" >&2; exit 2)
        rm -rf data/results/{wildcards.sample}/bakta
        bakta_bin="$(dirname {params.executable})"
        bakta_env="$(dirname "$bakta_bin")"
        bakta_trna_module="$bakta_env/lib/python"*"/site-packages/bakta/features/t_rna.py"
        BAKTA_TRNA_MODULE="$bakta_trna_module" "$bakta_bin/python" - <<'PY'
from pathlib import Path
import glob
import os

files = glob.glob(os.environ.get('BAKTA_TRNA_MODULE', ''))
if files:
    p = Path(files[0])
    text = p.read_text()
    text = text.replace(
        "        'tRNAscan-SE',",
        "        __import__('os').environ.get('BAKTA_TRNASCAN_SE', 'tRNAscan-SE'),",
    )
    text = text.replace(
        "        env=cfg.env,\n",
        "        env=dict(cfg.env, TMPDIR='/tmp', **{{k: v for k, v in __import__('os').environ.items() if k in {{'PATH', 'PERL5LIB', 'TRNASCAN_SE_REAL'}}}}),\n",
    )
    text = text.replace(
        "        env=dict(cfg.env, **{{k: v for k, v in __import__('os').environ.items() if k in {{'PATH', 'PERL5LIB', 'TRNASCAN_SE_REAL'}}}}),\n",
        "        env=dict(cfg.env, TMPDIR='/tmp', **{{k: v for k, v in __import__('os').environ.items() if k in {{'PATH', 'PERL5LIB', 'TRNASCAN_SE_REAL'}}}}),\n",
    )
    text = text.replace(
        "        str(sequences_path)\n",
        "        str(sequences_path.resolve())\n",
    )
    text = text.replace(
        "    txt_output_path = cfg.tmp_path.joinpath('trna.tsv')\n",
        "    txt_output_path = cfg.tmp_path.joinpath('trna.tsv').resolve()\n",
    )
    text = text.replace(
        "    fasta_output_path = cfg.tmp_path.joinpath('trna.fasta')\n",
        "    fasta_output_path = cfg.tmp_path.joinpath('trna.fasta').resolve()\n",
    )
    text = text.replace(
        "        cwd=str(cfg.tmp_path),\n",
        "        cwd=str(cfg.tmp_path.resolve()),\n",
    )
    text = text.replace(
        "        log.debug('stdout=\\'%s\\', stderr=\\'%s\\'', proc.stdout, proc.stderr)\n",
        "        log.warning('stdout=\\'%s\\', stderr=\\'%s\\'', proc.stdout, proc.stderr)\n",
    )
    p.write_text(text)
PY
        env PATH="$(dirname {params.trna_wrapper}):$bakta_bin:$PATH" \
            TMPDIR="/tmp" \
            BAKTA_TRNASCAN_SE="{params.trna_wrapper}" \
            TRNASCAN_SE_REAL="$bakta_bin/tRNAscan-SE" \
            PERL5LIB="$bakta_env/lib/perl5/core_perl" \
            "{params.executable}" --db {params.database} --threads {threads} --genus "Bacteria" --prefix {wildcards.sample} --output data/results/{wildcards.sample}/bakta --force --skip-sorf {input.assembly} > {log} 2>&1 || (
                status=$?
                echo "Bakta full annotation failed with exit code $status; retrying once with --skip-trna because tRNAscan-SE can be unstable in Docker." >> {log}
                rm -rf data/results/{wildcards.sample}/bakta
                env PATH="$(dirname {params.trna_wrapper}):$bakta_bin:$PATH" \
                    TMPDIR="/tmp" \
                    BAKTA_TRNASCAN_SE="{params.trna_wrapper}" \
                    TRNASCAN_SE_REAL="$bakta_bin/tRNAscan-SE" \
                    PERL5LIB="$bakta_env/lib/perl5/core_perl" \
                    "{params.executable}" --db {params.database} --threads {threads} --genus "Bacteria" --prefix {wildcards.sample} --output data/results/{wildcards.sample}/bakta --force --skip-sorf --skip-trna {input.assembly} >> {log} 2>&1
            )
        """


