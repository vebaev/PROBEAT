configfile: "workflow/config/config.yaml"

import csv
import os
from pathlib import Path

PYTHON = os.environ.get("PROBEAT_PYTHON", "python3")

def load_samples(samples_file):
    path = Path(samples_file)
    if not path.exists():
        return {}
    with path.open(newline="") as handle:
        rows = list(csv.DictReader(handle, delimiter="\t"))
    samples = {}
    for row in rows:
        sample = row["sample"].strip()
        if not sample:
            continue
        layout = row["layout"].strip().upper()
        if layout not in {"PE", "SE", "ONT", "HYBRID"}:
            raise ValueError(f"Sample {sample} has unsupported layout: {layout}")
        if not row["r1"].strip():
            raise ValueError(f"Sample {sample} is missing r1")
        if layout in {"PE", "HYBRID"} and not row["r2"].strip():
            raise ValueError(f"Sample {sample} is PE but missing r2")
        long_reads = row.get("long_reads", "").strip()
        if layout == "HYBRID" and not long_reads:
            raise ValueError(f"Sample {sample} is HYBRID but missing long_reads")
        samples[sample] = {"layout": layout, "r1": row["r1"].strip(), "r2": row["r2"].strip(), "long_reads": long_reads}
    return samples


SAMPLES = load_samples(config["samples_file"])
SAMPLE_NAMES = sorted(SAMPLES)
ANALYSIS_PROFILE = config.get("analysis_profile", "full")
EXTENDED_ANALYSIS = ANALYSIS_PROFILE != "core"


def env(name):
    return f"envs/{name}.yaml"


def db(name):
    if name == "bakta":
        preferred = Path(config["databases"][name])
        fallback = Path("data/databases/bakta")
        if preferred.exists():
            return str(preferred)
        if fallback.exists():
            return str(fallback)
    return config["databases"][name]


def tool(name):
    value = config.get("tools", {}).get(name, name)
    path = Path(value)
    if "/" in value and path.exists():
        return str(path.resolve())
    return value


def assembly_for_sample(sample):
    if SAMPLES[sample]["layout"] == "ONT":
        return f"data/results/{sample}/medaka/consensus.fasta"
    return f"data/results/{sample}/assembly/assembly.fasta"


def assembly(wildcards):
    return assembly_for_sample(wildcards.sample)


def trimmed_done(sample):
    return f"data/intermediate/trimmed/{sample}.done"


def fastqc_targets(sample=None):
    targets = []
    selected = {sample: SAMPLES[sample]} if sample else SAMPLES
    for name, meta in selected.items():
        if meta["layout"] in {"PE", "SE", "HYBRID"}:
            targets.append(f"data/results/{name}/qc/fastqc/{name}_R1_fastqc.html")
        if meta["layout"] in {"PE", "HYBRID"}:
            targets.append(f"data/results/{name}/qc/fastqc/{name}_R2_fastqc.html")
    return targets


def sample_analysis_targets(s):
    targets = fastqc_targets(s)
    targets += [assembly_for_sample(s), f"data/results/{s}/quast/report.tsv"]
    if config["params"].get("run_mash", False):
        targets += [f"data/results/{s}/mash/top_hits.tsv"]
    if config["params"].get("run_sourmash", False):
        targets += [f"data/results/{s}/sourmash/gather.with-lineages.csv"]
    if config["params"].get("run_busco", False):
        targets += [f"data/results/{s}/busco/busco_summary.txt"]
    if EXTENDED_ANALYSIS and config["params"].get("run_plasmidfinder", False):
        targets += [f"data/results/{s}/plasmidfinder/{s}.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_vfdb", False):
        targets += [f"data/results/{s}/vfdb/{s}.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_kofamscan", False):
        targets += [f"data/results/{s}/kofamscan/{s}.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_keggdecoder", False):
        targets += [f"data/results/{s}/keggdecoder/pathway_completeness.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_dbcan", False):
        targets += [f"data/results/{s}/dbcan/overview.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_pgmdb", False):
        targets += [
            f"data/results/{s}/pgmdb/summary.tsv",
            f"data/results/{s}/pgmdb/pgmdb_functional_potential.png",
        ]
    if EXTENDED_ANALYSIS and config["params"].get("run_gtdbtk", False):
        targets += [f"data/results/{s}/gtdbtk/gtdbtk.bac120.summary.tsv"]
    targets += [f"data/results/{s}/bakta/{s}.gff3"]
    if EXTENDED_ANALYSIS:
        targets += [f"data/results/{s}/amrfinder/{s}.tsv"]
        targets += [f"data/results/{s}/abricate/{s}_card.tsv"]
        targets += [f"data/results/{s}/abricate/{s}_megares.tsv"]
        targets += [f"data/results/{s}/bagel4/bacteriocin_clusters.tsv"]
        targets += [
            f"data/results/{s}/antismash/index.html",
            f"data/results/{s}/antismash/{s}_regions.tsv",
        ]
    if EXTENDED_ANALYSIS and config["params"].get("run_genomad", False):
        targets += [f"data/results/{s}/genomad/assembly_summary/assembly_plasmid_summary.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_eggnog", False):
        targets += [f"data/results/{s}/eggnog/{s}.emapper.annotations"]
        targets += [f"data/results/{s}/gut_brain_markers.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_kegganog", False):
        targets += [f"data/results/{s}/kegganog/{s}_pathways.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_genomespot", False):
        targets += [f"data/results/{s}/genomespot/{s}.predictions.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_gutsmash", False):
        targets += [f"data/results/{s}/gutsmash/.probeat_gutsmash_status.json"]
    if EXTENDED_ANALYSIS and config["params"].get("run_fastmlst", False):
        targets += [f"data/results/{s}/fastmlst/{s}_mlst.tsv"]
    if EXTENDED_ANALYSIS and config["params"].get("run_fastani", False):
        targets += [f"data/results/{s}/fastani/{s}_ani_heatmap.png"]
    if EXTENDED_ANALYSIS and config["params"].get("run_mobsuite", False):
        targets += [f"data/results/{s}/mobsuite/contig_report.txt"]
        targets += [f"data/results/{s}/mobsuite/mobtyper_results.txt"]
    if EXTENDED_ANALYSIS and config["params"].get("run_goprobioticprofiler", False):
        targets += [f"data/results/{s}/goprobioticprofiler/probiotic_go_summary.json"]
    if EXTENDED_ANALYSIS and config["params"].get("run_pycirclize", False):
        targets += [f"data/results/{s}/genome_map/{s}_genome_map.png"]
    return targets


def workflow_targets():
    if not SAMPLE_NAMES:
        return ["data/results/workflow_initialized.txt"]
    return [target for sample in SAMPLE_NAMES for target in sample_analysis_targets(sample)]


ANALYSIS_TARGETS = workflow_targets()
FINAL_TARGETS = [
    target
    for sample in SAMPLE_NAMES
    for target in (
        f"data/results/{sample}/report/{sample}_report.html",
        f"data/results/{sample}/report/{sample}_report.pdf",
    )
] if SAMPLE_NAMES else ANALYSIS_TARGETS


rule all:
    input:
        FINAL_TARGETS


rule initialize_workspace:
    output:
        results="data/results/workflow_initialized.txt"
    log:
        "logs/initialize_workspace.log"
    shell:
        r"""
        set -euo pipefail
        {{
            echo "Workspace initialized by Snakemake"
            echo "Raw data directory: {config[paths][raw]}"
            echo "Intermediate directory: {config[paths][intermediate]}"
            echo "Results directory: {config[paths][results]}"
            echo "Reports directory: {config[paths][reports]}"
            echo "Containers directory: {config[paths][containers]}"
        }} > {output.results}

        {{
            echo "Add samples to workflow/config/samples.tsv."
            echo "Bioinformatics applications run through separate Mamba environments."
        }} > {output.report}
        """


rule fastp_pe:
    input:
        r1=lambda wc: SAMPLES[wc.sample]["r1"],
        r2=lambda wc: SAMPLES[wc.sample]["r2"]
    output:
        r1="data/intermediate/trimmed/{sample}_R1.fastq.gz",
        r2="data/intermediate/trimmed/{sample}_R2.fastq.gz",
        html="data/results/{sample}/qc/fastp/{sample}.html",
        json="data/results/{sample}/qc/fastp/{sample}.json",
        done="data/intermediate/trimmed/{sample}_fastp_pe.done"
    log:
        "logs/trimmed/fastp_{sample}.log"
    threads: 8
    resources:
        mem_mb=12000
    conda:
        env("fastp")
    params:
        layout=lambda wc: SAMPLES[wc.sample]["layout"]
    shell:
        r"""
        test "{params.layout}" = "PE" -o "{params.layout}" = "HYBRID"
        fastp --thread {threads} --in1 {input.r1} --in2 {input.r2} --out1 {output.r1} --out2 {output.r2} --html {output.html} --json {output.json} > {log} 2>&1
        touch {output.done}
        """


rule fastp_se:
    input:
        r1=lambda wc: SAMPLES[wc.sample]["r1"]
    output:
        r1="data/intermediate/trimmed/{sample}_SE.fastq.gz",
        html="data/results/{sample}/qc/fastp/{sample}.html",
        json="data/results/{sample}/qc/fastp/{sample}.json",
        done="data/intermediate/trimmed/{sample}_fastp_se.done"
    log:
        "logs/trimmed/fastp_{sample}.log"
    threads: 8
    resources:
        mem_mb=8000
    conda:
        env("fastp")
    params:
        layout=lambda wc: SAMPLES[wc.sample]["layout"]
    shell:
        r"""
        test "{params.layout}" = "SE"
        fastp --thread {threads} --in1 {input.r1} --out1 {output.r1} --html {output.html} --json {output.json} > {log} 2>&1
        touch {output.done}
        """


rule porechop_ont:
    input:
        reads=lambda wc: SAMPLES[wc.sample]["long_reads"] if SAMPLES[wc.sample]["layout"] == "HYBRID" else SAMPLES[wc.sample]["r1"],
        summary_script="workflow/scripts/fastq_qc_summary.py"
    output:
        reads="data/intermediate/trimmed/{sample}_ONT.fastq.gz",
        summary="data/results/{sample}/qc/porechop/{sample}.json",
        done="data/intermediate/trimmed/{sample}_porechop.done"
    log:
        "logs/porechop/porechop_{sample}.log"
    threads: 8
    resources:
        mem_mb=16000
    conda:
        env("porechop")
    params:
        layout=lambda wc: SAMPLES[wc.sample]["layout"],
        executable=lambda wc: tool("porechop")
    shell:
        r"""
        test "{params.layout}" = "ONT" -o "{params.layout}" = "HYBRID"
        mkdir -p data/intermediate/trimmed data/results/{wildcards.sample}/qc/porechop logs/porechop
        PORECHOP="{params.executable}"
        if [ ! -x "$PORECHOP" ]; then
            PORECHOP="$(command -v porechop || true)"
        fi
        test -x "$PORECHOP" || \
            (echo "Missing Porechop executable. Install ont-tools or allow Snakemake to create workflow/envs/porechop.yaml." >&2; exit 2)
        "$PORECHOP" -i {input.reads} -o {output.reads} --threads {threads} > {log} 2>&1
        test -s {output.reads}
        {PYTHON} \
            {input.summary_script} {input.reads} {output.reads} {output.summary} >> {log} 2>&1
        touch {output.done}
        """


rule fastqc_r1:
    input:
        lambda wc: SAMPLES[wc.sample]["r1"]
    output:
        html="data/results/{sample}/qc/fastqc/{sample}_R1_fastqc.html",
        zip="data/results/{sample}/qc/fastqc/{sample}_R1_fastqc.zip"
    log:
        "logs/qc/fastqc_{sample}_R1.log"
    threads: 2
    resources:
        mem_mb=4000
    conda:
        env("fastqc")
    params:
        link=lambda wc: (
            f"data/intermediate/fastqc_inputs/{wc.sample}_R1.fastq.gz"
            if SAMPLES[wc.sample]["r1"].endswith(".gz")
            else f"data/intermediate/fastqc_inputs/{wc.sample}_R1.fastq"
        )
    shell:
        r"""
        mkdir -p data/intermediate/fastqc_inputs data/results/{wildcards.sample}/qc/fastqc
        ln -sf "$(realpath {input})" {params.link}
        fastqc --threads {threads} --outdir data/results/{wildcards.sample}/qc/fastqc {params.link} > {log} 2>&1
        """


rule fastqc_r2:
