rule bagel4:
    input:
        assembly=assembly
    output:
        done="data/results/bagel4/{sample}/bagel4.done"
    log:
        "logs/bagel4/bagel4_{sample}.log"
    threads: 8
    resources:
        mem_mb=16000
    params:
        run=lambda wc: str(config["params"]["run_bagel4"]).lower(),
        image=lambda wc: container("bagel4")
    shell:
        r"""
        mkdir -p data/results/bagel4/{wildcards.sample}
        if [ "{params.run}" != "true" ]; then
            echo "BAGEL4 skipped. Configure app_containers/bagel4.manual.sif and set params.run_bagel4=true." > {log}
            touch {output.done}
            exit 0
        fi
        test -s "{params.image}" || (echo "Missing BAGEL4 container: {params.image}" >&2; exit 2)
        apptainer exec --cleanenv --unsquash --bind /home/vebaev/codex:/home/vebaev/codex {params.image} bagel4 -i {input.assembly} -o data/results/bagel4/{wildcards.sample} -t {threads} > {log} 2>&1
        touch {output.done}
        """


