            printf 'sample\tinput_reads\ttarget_reads\toutput_reads\taction\n{wildcards.sample}\t%s\t%s\t%s\tsubsampled\n' "$reads" "{params.target}" "{params.target}" > {output.status}
        else
            cp {input.r1} {output.r1}
            printf 'sample\tinput_reads\ttarget_reads\toutput_reads\taction\n{wildcards.sample}\t%s\t%s\t%s\tkept_all\n' "$reads" "{params.target}" "$reads" > {output.status}
            echo "Rasusa skipped: $reads reads <= target {params.target}" > {log}
        fi
        """


rule rasusa_ont:
    input:
        reads="data/intermediate/trimmed/{sample}_ONT.fastq.gz"
    output:
        reads="data/intermediate/subsampled/{sample}_ONT.fastq.gz",
        status="data/results/{sample}/qc/rasusa/{sample}_ONT.tsv"
    log:
        "logs/rasusa/rasusa_{sample}.log"
    threads: 4
    resources:
        mem_mb=8000
    params:
        layout=lambda wc: SAMPLES[wc.sample]["layout"],
        executable=lambda wc: tool("rasusa"),
        genome_size=lambda wc: config["params"].get("ont_genome_size", "5m"),
        coverage=lambda wc: float(config["params"].get("ont_target_coverage", 100)),
        seed=lambda wc: int(config["params"].get("rasusa_seed", 42))
    shell:
        r"""
        test "{params.layout}" = "ONT" -o "{params.layout}" = "HYBRID"
        mkdir -p data/intermediate/subsampled data/results/{wildcards.sample}/qc/rasusa logs/rasusa
        env PATH="$(dirname {params.executable}):$PATH" {params.executable} reads {input.reads} --genome-size {params.genome_size} --coverage {params.coverage} \
            --seed {params.seed} --output {output.reads} > {log} 2>&1
        test -s {output.reads}
        printf 'sample\tinput_reads\ttarget_reads\toutput_reads\taction\n{wildcards.sample}\tNA\t%s\tNA\tsubsampled_by_coverage\n' \
            "{params.coverage}x @ {params.genome_size}" > {output.status}
        """


rule unicycler:
    input:
        unpack(unicycler_inputs)
    output:
        assembly="data/results/{sample}/assembly/assembly.fasta"
    log:
        "logs/assemblies/unicycler_{sample}.log"
    threads: 16
    resources:
        mem_mb=64000
    conda:
        env("unicycler")
    params:
        reads=unicycler_read_args
    shell:
        "rm -rf data/results/{wildcards.sample}/assembly && "
        "unicycler {params.reads} -o data/results/{wildcards.sample}/assembly -t {threads} > {log} 2>&1"


rule flye_ont:
    input:
        reads="data/intermediate/subsampled/{sample}_ONT.fastq.gz"
    output:
        assembly="data/results/{sample}/flye/assembly.fasta"
    log:
        "logs/flye/flye_{sample}.log"
    threads: 24
    resources:
        mem_mb=128000
    conda:
        env("flye")
    params:
        layout=lambda wc: SAMPLES[wc.sample]["layout"],
        executable=lambda wc: tool("flye"),
        genome_size=lambda wc: config["params"].get("ont_genome_size", "5m"),
        mode=lambda wc: config["params"].get("flye_ont_mode", "nano-hq"),
        run_threads=lambda wc: int(config["params"].get("flye_threads", 1))
    shell:
        r"""
        test "{params.layout}" = "ONT"
        FLYE="{params.executable}"
        if [ ! -x "$FLYE" ]; then
            FLYE="$(command -v flye || true)"
        fi
        test -x "$FLYE" || \
            (echo "Missing Flye executable. Install ont-tools or allow Snakemake to create workflow/envs/flye.yaml." >&2; exit 2)
        if test -s data/results/{wildcards.sample}/flye/params.json; then
            env FLYE_NO_MANAGER=1 PATH="$(dirname "$FLYE"):$PATH" "$FLYE" \
                --{params.mode} {input.reads} --genome-size {params.genome_size} --resume \
                --out-dir data/results/{wildcards.sample}/flye --threads {params.run_threads} > {log} 2>&1
        else
            env FLYE_NO_MANAGER=1 PATH="$(dirname "$FLYE"):$PATH" "$FLYE" \
                --{params.mode} {input.reads} --genome-size {params.genome_size} \
                --out-dir data/results/{wildcards.sample}/flye --threads {params.run_threads} > {log} 2>&1
        fi
        test -s {output.assembly}
        """


rule medaka_ont:
    input:
        reads="data/intermediate/subsampled/{sample}_ONT.fastq.gz",
        assembly="data/results/{sample}/flye/assembly.fasta"
    output:
        consensus="data/results/{sample}/medaka/consensus.fasta"
    log:
        "logs/medaka/medaka_{sample}.log"
    threads: 16
    resources:
        mem_mb=64000
    conda:
        env("medaka")
    params:
        layout=lambda wc: SAMPLES[wc.sample]["layout"],
        executable=lambda wc: tool("medaka"),
        model=lambda wc: config["params"].get("medaka_model", "r1041_e82_400bps_sup_v5.0.0")
    shell:
        r"""
        test "{params.layout}" = "ONT"
        rm -rf data/results/{wildcards.sample}/medaka
        MEDAKA="{params.executable}"
        if [ ! -x "$MEDAKA" ]; then
            MEDAKA="$(command -v medaka_consensus || true)"
        fi
        test -x "$MEDAKA" || \
            (echo "Missing Medaka executable. Install ont-tools or allow Snakemake to create workflow/envs/medaka.yaml." >&2; exit 2)
        env PATH="$(dirname "$MEDAKA"):$PATH" "$MEDAKA" -i {input.reads} -d {input.assembly} \
            -o data/results/{wildcards.sample}/medaka -t {threads} -m {params.model} > {log} 2>&1
        test -s {output.consensus}
        """


rule quast:
    input:
        assembly=assembly
    output:
        report="data/results/{sample}/quast/report.tsv"
    log:
        "logs/quast/quast_{sample}.log"
    threads: 8
    resources:
        mem_mb=16000
    conda:
        env("quast")
    shell:
        "quast.py --threads {threads} --min-contig {config[params][min_contig_length]} -o data/results/{wildcards.sample}/quast {input.assembly} > {log} 2>&1"


rule mash:
    input:
        assembly=assembly
    output:
        hits="data/results/{sample}/mash/top_hits.tsv"
    log:
        "logs/mash/mash_{sample}.log"
    threads: 8
    resources:
        mem_mb=16000
    params:
        executable=lambda wc: tool("mash"),
        database=lambda wc: db("mash"),
        top_hits=lambda wc: config["params"].get("mash_top_hits", 10)
    shell:
        r"""
        test -x "{params.executable}" || (echo "Missing Mash executable: {params.executable}" >&2; exit 2)
        test -s "{params.database}" || (echo "Missing Mash database: {params.database}" >&2; exit 2)
        mkdir -p data/results/{wildcards.sample}/mash
        {params.executable} dist -p {threads} {params.database} {input.assembly} 2> {log} \
            | sort -g -k3,3 \
            | awk 'NR <= {params.top_hits}' \
            > {output.hits}
        """


rule sourmash_sketch:
    input:
        assembly=assembly,
        mash="data/results/{sample}/mash/top_hits.tsv"
