    log:
        "logs/qc/fastqc_{sample}_R2.log"
    threads: 2
    resources:
        mem_mb=4000
    conda:
        env("fastqc")
    params:
        layout=lambda wc: SAMPLES[wc.sample]["layout"],
        link=lambda wc: (
            f"data/intermediate/fastqc_inputs/{wc.sample}_R2.fastq.gz"
            if SAMPLES[wc.sample]["r2"].endswith(".gz")
            else f"data/intermediate/fastqc_inputs/{wc.sample}_R2.fastq"
        )
    shell:
        r"""
        test "{params.layout}" = "PE" -o "{params.layout}" = "HYBRID"
        mkdir -p data/intermediate/fastqc_inputs data/results/{wildcards.sample}/qc/fastqc
        ln -sf "$(realpath {input})" {params.link}
        fastqc --threads {threads} --outdir data/results/{wildcards.sample}/qc/fastqc {params.link} > {log} 2>&1
        """


def unicycler_inputs(wildcards):
    if SAMPLES[wildcards.sample]["layout"] == "PE":
        return {
            "r1": f"data/intermediate/subsampled/{wildcards.sample}_R1.fastq.gz",
            "r2": f"data/intermediate/subsampled/{wildcards.sample}_R2.fastq.gz",
        }
    if SAMPLES[wildcards.sample]["layout"] == "HYBRID":
        return {
            "r1": f"data/intermediate/subsampled/{wildcards.sample}_R1.fastq.gz",
            "r2": f"data/intermediate/subsampled/{wildcards.sample}_R2.fastq.gz",
            "long_reads": f"data/intermediate/subsampled/{wildcards.sample}_ONT.fastq.gz",
        }
    return {"r1": f"data/intermediate/subsampled/{wildcards.sample}_SE.fastq.gz"}


def unicycler_read_args(wildcards):
    layout = SAMPLES[wildcards.sample]["layout"]
    if layout == "PE":
        return f"-1 data/intermediate/subsampled/{wildcards.sample}_R1.fastq.gz -2 data/intermediate/subsampled/{wildcards.sample}_R2.fastq.gz"
    if layout == "HYBRID":
        return (
            f"-1 data/intermediate/subsampled/{wildcards.sample}_R1.fastq.gz "
            f"-2 data/intermediate/subsampled/{wildcards.sample}_R2.fastq.gz "
            f"-l data/intermediate/subsampled/{wildcards.sample}_ONT.fastq.gz"
        )
    return f"-s data/intermediate/subsampled/{wildcards.sample}_SE.fastq.gz"


rule rasusa_pe:
    input:
        r1="data/intermediate/trimmed/{sample}_R1.fastq.gz",
        r2="data/intermediate/trimmed/{sample}_R2.fastq.gz"
    output:
        r1="data/intermediate/subsampled/{sample}_R1.fastq.gz",
        r2="data/intermediate/subsampled/{sample}_R2.fastq.gz",
        status="data/results/{sample}/qc/rasusa/{sample}_PE.tsv"
    log:
        "logs/rasusa/rasusa_{sample}.log"
    threads: 4
    resources:
        mem_mb=8000
    params:
        layout=lambda wc: SAMPLES[wc.sample]["layout"],
        executable=lambda wc: tool("rasusa"),
        target=lambda wc: int(config["params"].get("target_reads_after_fastp", 3000000)),
        seed=lambda wc: int(config["params"].get("rasusa_seed", 42))
    shell:
        r"""
        test "{params.layout}" = "PE" -o "{params.layout}" = "HYBRID"
        mkdir -p data/intermediate/subsampled data/results/{wildcards.sample}/qc/rasusa logs/rasusa
        reads="$({PYTHON} -c 'import json,sys; print(json.load(open(sys.argv[1]))["summary"]["after_filtering"]["total_reads"])' data/results/{wildcards.sample}/qc/fastp/{wildcards.sample}.json)"
        if [ "$reads" -gt "{params.target}" ]; then
            pairs=$(({params.target} / 2))
            env PATH="$(dirname {params.executable}):$PATH" {params.executable} reads {input.r1} {input.r2} \
                --num "$pairs" --seed {params.seed} --output {output.r1} --output {output.r2} > {log} 2>&1
            printf 'sample\tinput_reads\ttarget_reads\toutput_reads\taction\n{wildcards.sample}\t%s\t%s\t%s\tsubsampled\n' "$reads" "{params.target}" "{params.target}" > {output.status}
        else
            cp {input.r1} {output.r1}
            cp {input.r2} {output.r2}
            printf 'sample\tinput_reads\ttarget_reads\toutput_reads\taction\n{wildcards.sample}\t%s\t%s\t%s\tkept_all\n' "$reads" "{params.target}" "$reads" > {output.status}
            echo "Rasusa skipped: $reads reads <= target {params.target}" > {log}
        fi
        """


rule rasusa_se:
    input:
        r1="data/intermediate/trimmed/{sample}_SE.fastq.gz"
    output:
        r1="data/intermediate/subsampled/{sample}_SE.fastq.gz",
        status="data/results/{sample}/qc/rasusa/{sample}_SE.tsv"
    log:
        "logs/rasusa/rasusa_{sample}.log"
    threads: 4
    resources:
        mem_mb=8000
    params:
        executable=lambda wc: tool("rasusa"),
        target=lambda wc: int(config["params"].get("target_reads_after_fastp", 3000000)),
        seed=lambda wc: int(config["params"].get("rasusa_seed", 42))
    shell:
        r"""
        mkdir -p data/intermediate/subsampled data/results/{wildcards.sample}/qc/rasusa logs/rasusa
        reads="$({PYTHON} -c 'import json,sys; print(json.load(open(sys.argv[1]))["summary"]["after_filtering"]["total_reads"])' data/results/{wildcards.sample}/qc/fastp/{wildcards.sample}.json)"
        if [ "$reads" -gt "{params.target}" ]; then
