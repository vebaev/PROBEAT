rule genomad:
    input:
        assembly=assembly
    output:
        plasmid_summary="data/results/{sample}/genomad/assembly_summary/assembly_plasmid_summary.tsv",
        virus_summary="data/results/{sample}/genomad/assembly_summary/assembly_virus_summary.tsv"
    log:
        "logs/genomad/genomad_{sample}.log"
    threads: 16
    resources:
        mem_mb=32000
    conda:
        env("genomad")
    params:
        executable=lambda wc: tool("genomad"),
        database=lambda wc: db("genomad")
    shell:
        r"""
        exe="{params.executable}"
        if ! test -x "$exe"; then
            exe="$(command -v genomad || true)"
        fi
        test -x "$exe" || (echo "Missing geNomad executable" >&2; exit 2)
        test -d "{params.database}" || (echo "Missing geNomad database: {params.database}" >&2; exit 2)
        export PATH="$(dirname "$exe"):$PATH"
        rm -rf data/results/{wildcards.sample}/genomad
        "$exe" end-to-end {input.assembly} data/results/{wildcards.sample}/genomad {params.database} --cleanup --threads {threads} > {log} 2>&1
        summary_dir="$(find data/results/{wildcards.sample}/genomad -mindepth 1 -maxdepth 1 -type d -name '*_summary' | head -n 1)"
        test -n "$summary_dir" || (echo "Missing geNomad summary directory" >&2; exit 2)
        mkdir -p data/results/{wildcards.sample}/genomad/assembly_summary
        plasmid_summary="$(find "$summary_dir" -maxdepth 1 -type f -name '*_plasmid_summary.tsv' | head -n 1)"
        virus_summary="$(find "$summary_dir" -maxdepth 1 -type f -name '*_virus_summary.tsv' | head -n 1)"
        if [ -n "$plasmid_summary" ] && [ -s "$plasmid_summary" ]; then
            if [ "$(readlink -f "$plasmid_summary")" != "$(readlink -f {output.plasmid_summary})" ]; then
                cp "$plasmid_summary" {output.plasmid_summary}
            fi
        else
            printf '%s\n' 'seq_name	length	topology	plasmid_score	fdr	n_hallmarks	marker_enrichment' > {output.plasmid_summary}
        fi
        if [ -n "$virus_summary" ] && [ -s "$virus_summary" ]; then
            if [ "$(readlink -f "$virus_summary")" != "$(readlink -f {output.virus_summary})" ]; then
                cp "$virus_summary" {output.virus_summary}
            fi
        else
            printf '%s\n' 'seq_name	length	topology	virus_score	fdr	n_hallmarks	marker_enrichment' > {output.virus_summary}
        fi
        test -s {output.plasmid_summary} || (echo "Missing geNomad plasmid summary" >&2; exit 2)
        test -s {output.virus_summary} || (echo "Missing geNomad virus summary" >&2; exit 2)
        """


rule eggnog:
    input:
        proteins="data/results/{sample}/bakta/{sample}.faa"
    output:
        annotations="data/results/{sample}/eggnog/{sample}.emapper.annotations"
    log:
        "logs/eggnog/eggnog_{sample}.log"
    threads: 36
    resources:
        mem_mb=128000
    conda:
        env("eggnog")
    params:
        executable=lambda wc: tool("eggnog"),
        database=lambda wc: db("eggnog")
    shell:
        r"""
        exe="{params.executable}"
        if ! test -x "$exe"; then
            exe="$(command -v emapper.py || true)"
        fi
        test -x "$exe" || (echo "Missing eggNOG-mapper executable" >&2; exit 2)
        test -d "{params.database}" || (echo "Missing eggNOG database: {params.database}" >&2; exit 2)
        mkdir -p data/results/{wildcards.sample}/eggnog tmp
        export TMPDIR=$(realpath tmp)
        export PATH="$(dirname "$exe"):$PATH"
        "$exe" -m diamond -i {input.proteins} --itype proteins \
            --data_dir {params.database} \
            -o {wildcards.sample} --output_dir data/results/{wildcards.sample}/eggnog \
            --temp_dir tmp \
            --cpu {threads} --override --no_annot --dmnd_iterate no > {log} 2>&1
        test -s data/results/{wildcards.sample}/eggnog/{wildcards.sample}.emapper.seed_orthologs || (echo "Missing seed orthologs" >&2; exit 2)
        "$exe" --annotate_hits_table data/results/{wildcards.sample}/eggnog/{wildcards.sample}.emapper.seed_orthologs \
            --data_dir {params.database} \
            -o {wildcards.sample} --output_dir data/results/{wildcards.sample}/eggnog \
            --temp_dir tmp \
            --cpu {threads} --override >> {log} 2>&1
        test -s {output.annotations} || (echo "Missing eggNOG annotations" >&2; exit 2)
        "$(dirname "$exe")/python" workflow/scripts/plot_transport_radar.py {output.annotations} data/results/{wildcards.sample}/eggnog/{wildcards.sample}_transport.tsv >> {log} 2>&1
        "$(dirname "$exe")/python" workflow/scripts/export_ec_table.py {output.annotations} data/results/{wildcards.sample}/eggnog/{wildcards.sample}_ec.tsv >> {log} 2>&1
        MPLCONFIGDIR="$PWD/.cache/matplotlib" "$(dirname "$exe")/python" workflow/scripts/plot_cog_radar.py {output.annotations} \
            data/results/{wildcards.sample}/eggnog/{wildcards.sample}_cog_radar.png >> {log} 2>&1
        """


