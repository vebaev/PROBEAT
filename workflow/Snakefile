    output:
        summary="data/results/{sample}/bagel4/bacteriocin_clusters.tsv",
        done="data/results/{sample}/bagel4/bagel4.done"
    log:
        "logs/bagel4/bagel4_{sample}.log"
    threads: 8
    resources:
        mem_mb=16000
    conda:
        env("bagel4")
    params:
        run=lambda wc: str(config["params"]["run_bagel4"]).lower(),
        database=lambda wc: db("bagel4"),
        env_dir="mamba_envs/bagel4",
        context=lambda wc: int(config["params"].get("bagel4_context_size", 20000))
    shell:
        r"""
        rm -rf data/results/{wildcards.sample}/bagel4
        mkdir -p data/results/{wildcards.sample}/bagel4/session/queryfolder
        if [ "{params.run}" != "true" ]; then
            printf 'AOI\tstart\tend\tclass\tfullname\n' > {output.summary}
            echo "BAGEL4 skipped by configuration." > {log}
            touch {output.done}
            exit 0
        fi
        test -x "{params.database}/bagel4_wrapper.pl" || (echo "BAGEL4 is not installed. Run: workflow/scripts/install_databases.sh bagel4" >&2; exit 2)
        perl="{params.env_dir}/bin/perl"
        blastp="{params.env_dir}/bin/blastp"
        tblastn="{params.env_dir}/bin/tblastn"
        if ! test -x "$perl"; then
            perl="$(command -v perl || true)"
        fi
        if ! test -x "$blastp"; then
            blastp="$(command -v blastp || true)"
        fi
        if ! test -x "$tblastn"; then
            tblastn="$(command -v tblastn || true)"
        fi
        test -x "$perl" || (echo "Missing BAGEL4 perl executable" >&2; exit 2)
        test -x "$blastp" || (echo "Missing BLAST+ blastp for BAGEL4" >&2; exit 2)
        test -x "$tblastn" || (echo "Missing BLAST+ tblastn for BAGEL4 fallback" >&2; exit 2)
        bagel_env_bin="$(dirname "$perl")"
        runtime_db="$PWD/data/results/{wildcards.sample}/bagel4/runtime_db"
        rm -rf "$runtime_db"
        cp -a "{params.database}" "$runtime_db"
        chmod -R u+rwX "$runtime_db"
        find "$runtime_db" -type f \( -name '*.pl' -o -name '*.pm' -o -name '*.conf' -o -name '*.txt' \) -print0 |
            xargs -0 sed -i \
                -e "s#/home/vebaev/codex#$PWD#g" \
                -e "s#^glimmerpath *=.*#glimmerpath = $bagel_env_bin#" \
                -e "s#^hmmsearch *=.*#hmmsearch = $bagel_env_bin#"
        find "$runtime_db" -maxdepth 1 -type f -name '*.pl' -exec chmod +x {{}} +
        cp {input.assembly} data/results/{wildcards.sample}/bagel4/session/queryfolder/{wildcards.sample}.fna
        env PATH="$(dirname "$perl"):$(dirname "$blastp"):$PATH" PERL5LIB="$runtime_db/lib" \
            "$perl" "$runtime_db/bagel4_wrapper.pl" \
            -s "$PWD/data/results/{wildcards.sample}/bagel4/session" \
            -query "$PWD/data/results/{wildcards.sample}/bagel4/session/queryfolder" \
            -webserver 1 -r '*.fna' > {log} 2>&1
        if grep -Eq 'Can.t exec|No such file or directory|command not found|BEGIN failed' {log}; then
            echo "BAGEL4 reported a missing executable or dependency; see {log}" >&2
            exit 2
        fi
        {PYTHON} \
            {input.script} data/results/{wildcards.sample}/bagel4/session {output.summary}
        if [ "$(wc -l < {output.summary})" -le 1 ]; then
            {PYTHON} \
                {input.fallback_script} {input.assembly} "$runtime_db" \
                "$tblastn" {output.summary} {params.context}
        fi
        mkdir -p data/results/{wildcards.sample}/bagel4/graphics
        {PYTHON} \
            {input.draw_script} {input.bakta} {output.summary} data/results/{wildcards.sample}/bagel4/graphics {input.assembly} {input.bakta_fna}
        for svg in data/results/{wildcards.sample}/bagel4/graphics/*.svg; do
            [ -e "$svg" ] || continue
            rsvg="$(dirname {PYTHON})/rsvg-convert"
            if [ ! -x "$rsvg" ]; then
                rsvg="$(command -v rsvg-convert || true)"
            fi
            if [ -x "$rsvg" ]; then
                "$rsvg" -o "${{svg%.svg}}.png" "$svg"
            else
                echo "rsvg-convert unavailable; keeping BAGEL4 SVG graphic only for $svg" >> {log}
            fi
        done
        touch {output.done}
        """


