def unicycler_inputs(wildcards):
    if SAMPLES[wildcards.sample]["layout"] == "PE":
        return {
            "r1": f"data/intermediate/trimmed/{wildcards.sample}_R1.fastq.gz",
            "r2": f"data/intermediate/trimmed/{wildcards.sample}_R2.fastq.gz",
        }
    return {"r1": f"data/intermediate/trimmed/{wildcards.sample}_SE.fastq.gz"}


rule unicycler:
    input:
        unpack(unicycler_inputs)
    output:
        assembly="data/results/assemblies/{sample}/assembly.fasta"
    log:
        "logs/assemblies/unicycler_{sample}.log"
    threads: 16
    resources:
        mem_mb=64000
    container:
        container("unicycler")
    params:
        reads=lambda wc: (
            f"-1 data/intermediate/trimmed/{wc.sample}_R1.fastq.gz -2 data/intermediate/trimmed/{wc.sample}_R2.fastq.gz"
            if SAMPLES[wc.sample]["layout"] == "PE"
            else f"-s data/intermediate/trimmed/{wc.sample}_SE.fastq.gz"
        )
    shell:
        "unicycler {params.reads} -o data/results/assemblies/{wildcards.sample} -t {threads} > {log} 2>&1"


rule quast:
    input:
        assembly=assembly
    output:
        report="data/results/quast/{sample}/report.tsv"
    log:
        "logs/quast/quast_{sample}.log"
    threads: 8
    resources:
        mem_mb=16000
    container:
        container("quast")
    shell:
        "quast.py --threads {threads} --min-contig {config[params][min_contig_length]} -o data/results/quast/{wildcards.sample} {input.assembly} > {log} 2>&1"


rule checkm2:
    input:
        assembly=assembly
    output:
        report="data/results/checkm2/{sample}/quality_report.tsv"
    log:
        "logs/checkm2/checkm2_{sample}.log"
    threads: 16
    resources:
        mem_mb=64000
    container:
        container("checkm2")
    params:
        database=lambda wc: db("checkm2")
    shell:
        r"""
        test -d "{params.database}" || (echo "Missing CheckM2 database: {params.database}" >&2; exit 2)
        checkm2 predict --threads {threads} --database_path {params.database} --input {input.assembly} --output-directory data/results/checkm2/{wildcards.sample} > {log} 2>&1
        """


rule gtdbtk:
    input:
        assembly=assembly
    output:
        summary="data/results/gtdbtk/{sample}/gtdbtk.bac120.summary.tsv"
    log:
        "logs/gtdbtk/gtdbtk_{sample}.log"
    threads: 24
    resources:
        mem_mb=96000
    container:
        container("gtdbtk")
    params:
        database=lambda wc: db("gtdbtk")
    shell:
        r"""
        test -d "{params.database}" || (echo "Missing GTDB-Tk database: {params.database}" >&2; exit 2)
        export GTDBTK_DATA_PATH="{params.database}"
        mkdir -p data/intermediate/gtdbtk/{wildcards.sample}
        cp {input.assembly} data/intermediate/gtdbtk/{wildcards.sample}/{wildcards.sample}.fna
        gtdbtk classify_wf --genome_dir data/intermediate/gtdbtk/{wildcards.sample} --out_dir data/results/gtdbtk/{wildcards.sample} --extension fna --cpus {threads} > {log} 2>&1
        """


rule bakta:
    input:
        assembly=assembly
    output:
        gff="data/results/bakta/{sample}/{sample}.gff3"
    log:
        "logs/bakta/bakta_{sample}.log"
    threads: 16
    resources:
        mem_mb=64000
    container:
        container("bakta")
    params:
        database=lambda wc: db("bakta")
    shell:
        r"""
        test -d "{params.database}" || (echo "Missing Bakta database: {params.database}" >&2; exit 2)
        bakta --db {params.database} --threads {threads} --genus "Bacteria" --prefix {wildcards.sample} --output data/results/bakta/{wildcards.sample} {input.assembly} > {log} 2>&1
        """


